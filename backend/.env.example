# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Dipakai untuk menampilkan URL webhook di halaman Settings (opsional)
PUBLIC_BASE_URL=https://api.domainanda.com

# ---- Database (Postgres / Supabase connection string) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/wa_blast
# Set true bila memakai Supabase / host yang mewajibkan SSL
DATABASE_SSL=false

# ---- Keamanan ----
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=ganti_dengan_64_karakter_hex
JWT_SECRET=ganti_dengan_string_acak_panjang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_kuat

# ---- Meta / WhatsApp Cloud API ----
GRAPH_VERSION=v20.0
# Token verifikasi webhook: isi nilai yang sama di Meta App Dashboard > WhatsApp > Configuration
WEBHOOK_VERIFY_TOKEN=ganti_dengan_token_bebas
# App Secret (Meta App > Settings > Basic). Dipakai memvalidasi signature webhook
META_APP_SECRET=
# App ID. Dipakai untuk upload sample media saat membuat template ber-header gambar/PDF
META_APP_ID=

# ---- Blast engine ----
DEFAULT_COUNTRY_CODE=62
MAX_ATTEMPTS=3
